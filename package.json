{
  "name": "smeid",
  "version": "1.0.0",
  "description": "Visor y editor local de diagramas (sintaxis compatible con Mermaid). Software libre.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "SMITH SNEIDER A.M",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithsneiderangulomontero-hub/Smeid.git"
  },
  "homepage": "https://github.com/smithsneiderangulomontero-hub/Smeid#readme",
  "bugs": {
    "url": "https://github.com/smithsneiderangulomontero-hub/Smeid/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses": "node scripts/generate-third-party-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "mermaid": "^11.17.2"
  }
}
